# Minimal environment variables used by external services.
# Training behavior is configured via Hydra YAML in `conf/`.

# Weights & Biases (required for online logging when runtime.wandb.enabled=true)
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=lilybert
WANDB_ENTITY=your_wandb_entity
WANDB_MODE=online

# Hugging Face Hub (used by scripts/upload_dataset.py and scripts/upload_model.py)
HF_TOKEN=your_huggingface_token
